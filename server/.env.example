# One web/API server. Only local development can preview without credentials.
PORT=3008
ALLOWED_ORIGINS=http://127.0.0.1:5173
# Set only for a verified, fixed proxy topology. 0 is conservative behind proxies.
TRUST_PROXY_HOPS=0

# Required for production login + profile/route sync; apply migration 003.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY aliases are also supported.

# All paid AI routes are off by default. Never put keys in VITE_ variables.
AI_ENABLED=false
CLAUDE_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
AI_IP_HASH_SECRET=
AI_USER_DAILY_LIMIT=3
AI_USER_MONTHLY_LIMIT=10
AI_IP_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=20
AI_GLOBAL_MONTHLY_LIMIT=100
AI_COOLDOWN_SECONDS=60

# Optional town search: leave off until choosing a provider and reading its policy.
# https://operations.osmfoundation.org/policies/nominatim/
# Do not use public Nominatim on Vercel: its global rate limit needs shared coordination.
# Configure a managed/self-hosted compatible provider under its own policy.
NOMINATIM_BASE_URL=
GEOCODING_USER_AGENT=Solvaa/2.0 (replace with your site URL and contact)
RIDB_API_KEY=

# Optional alternative Overpass interpreter; public instances may time out.
OVERPASS_URL=
